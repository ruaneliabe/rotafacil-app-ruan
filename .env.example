# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: public URL where the app is hosted.
APP_URL="MY_APP_URL"

# Firebase server/runtime configuration.
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_APP_ID=""
FIRESTORE_DATABASE_ID=""

# Cardapio Web secrets are SERVER-SIDE ONLY.
# Never prefix this variable with VITE_ and never save apiKey in Firestore/client state.
# Configure this value in Vercel Environment Variables for Production/Preview.
# Example with fake keys only:
CARDAPIO_WEB_STORES_JSON='[{"storeId":"loja-centro","name":"Minha Loja Centro","prefix":"LC","apiKey":"SECRET_FROM_CARDAPIO_WEB","originLat":-26.9194,"originLng":-49.0661},{"storeId":"loja-bairro","name":"Minha Loja Bairro","prefix":"LB","apiKey":"ANOTHER_SECRET","originLat":-26.9200,"originLng":-49.0700}]'
