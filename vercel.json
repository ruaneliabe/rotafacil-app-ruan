{
  "rewrites": [
    {
      "source": "/api/cardapio-web/sync",
      "destination": "/api/sync-cardapio-web"
    },
    {
      "source": "/api/webhook/cardapio-web/:branchId",
      "destination": "/api/webhook-cardapio-web?branchId=:branchId"
    },
    {
      "source": "/api/webhook/cardapio-web",
      "destination": "/api/webhook-cardapio-web"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
